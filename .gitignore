data/sources/abc/*.pdf

# --- Afgeleid van microdata: bevat aantallen waarnemingen per cel -----------
# BE-SILC 2024, uitvoer van de Stata-stap m00. De publieke afgeleiden
# data/raw/micro_silc_gewichten.csv (gewichten) en micro_silc_groepen.csv
# (aantallen per groep, niet per cel) volstaan om alles te reproduceren.
data/raw/kakwani_gewichten_besilc2024.csv
data/raw/kakwani_gewichten_eq_besilc2024.csv
data/raw/*.log

